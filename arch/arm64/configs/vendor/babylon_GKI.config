# Display
CONFIG_XIAOMI_DISP_NOTIFIER=m

# Fingerprint
CONFIG_FINGERPRINT_XIAOMI_FP=m
CONFIG_INPUT_FINGERPRINT=y

# IR
CONFIG_IR_SPI=m

# MTD
CONFIG_MTD=m
CONFIG_MTD_BLOCK=m
CONFIG_MTD_BLOCK2MTD=m
CONFIG_MTD_OOPS=m

# Power supply
CONFIG_MI_WIRELESS=y

# Product
CONFIG_TARGET_PRODUCT_BABYLON=y

# Regulator
CONFIG_REGULATOR_WillSemi_WL2866D=m

# Touchscreen
CONFIG_TOUCHSCREEN_ST_FTS_SPI_DUAL=m
CONFIG_TOUCHSCREEN_XIAOMI_TOUCHFEATURE=m

# Xiaomi HWID
CONFIG_MI_HARDWARE_ID=m

# CONFIG_QCOM_WCD_USBSS_I2C is not set
